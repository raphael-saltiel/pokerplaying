# Copie ce fichier en `.env.local` (en local) et renseigne ces variables.
# Sur Vercel, ajoute-les dans Project Settings > Environment Variables.

# URL de ton projet Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique "anon" (Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé "service_role" (Project Settings > API > Project API keys > service_role)
# SECRET — jamais exposée au navigateur, utilisée uniquement côté serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
